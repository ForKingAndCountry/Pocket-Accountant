# Copy this file to `.env` in the same folder (backend/) and edit the values.
#
# MONGODB_URI = where your database lives
#   Local MongoDB:  mongodb://127.0.0.1:27017/pocket_accountant
# MongoDB Atlas example (encode special chars in password: @ → %40, # → %23, etc.)
# MONGODB_URI=mongodb+srv://appuser:YOUR_URL_ENCODED_PASSWORD@main-cluster.g00gt7c.mongodb.net/pocket_accountant?retryWrites=true&w=majority&appName=main-cluster
#
# JWT_SECRET = any long random string (used to sign login tokens — keep private)

MONGODB_URI=mongodb://127.0.0.1:27017/pocket_accountant
JWT_SECRET=change_this_to_a_long_random_secret
# Password for the web admin dashboard (http://localhost:3000/admin)
ADMIN_API_KEY=change_this_admin_key_min_8_chars
PORT=3000

# Optional — password reset emails (Gmail example: use an App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=obiaws96@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_FROM="CashSense Support <obiaws96@gmail.com>"
